{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "sourceMap": false,
    "declaration": false,
    "outDir": "./dist",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "ts-node": {
    "moduleTypes": {
      "web/src/lib/site.ts": "cjs"
    }
  },
  "include": ["*.ts"],
  "exclude": ["web", "dist", "node_modules"]
}
