---
import { socialLinks } from '../lib/site'
---

<div class="socials-menu" data-socials-menu>
  <button
    type="button"
    class="socials-menu-trigger"
    id="socialsMenuTrigger"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="socialsMenu"
    aria-label="Social links"
    title="Social links"
  >
    <span class="socials-menu-at" aria-hidden="true">@</span>
  </button>
  <div class="socials-menu-panel" id="socialsMenu" role="menu" hidden>
    {
      socialLinks.map((item) => (
        <a
          class="socials-menu-item"
          role="menuitem"
          href={item.href}
          data-icon={item.id}
          {...(item.href.startsWith('http')
            ? { target: '_blank', rel: 'noopener noreferrer' }
            : {})}
        >
          <span class="socials-menu-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path fill="currentColor" d={item.iconPath} />
            </svg>
          </span>
          <span class="socials-menu-label">{item.label}</span>
        </a>
      ))
    }
  </div>
</div>

<script is:inline>
  ;(function () {
    var root = document.querySelector('[data-socials-menu]')
    if (!root) return
    var trigger = root.querySelector('.socials-menu-trigger')
    var panel = root.querySelector('.socials-menu-panel')
    if (!trigger || !panel) return

    var animTimer = 0
    var leaveTimer = 0
    var pinned = false
    var reduceMotion = false
    var hoverCapable = false
    try {
      reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    } catch (e) {}
    try {
      // Fine pointer + real hover: open on hover. Touch / coarse: click only.
      hoverCapable = window.matchMedia('(hover: hover) and (pointer: fine)').matches
    } catch (e) {}

    function isOpen() {
      return trigger.getAttribute('aria-expanded') === 'true'
    }

    function setPinned(next) {
      pinned = !!next
      trigger.toggleAttribute('data-pinned', pinned)
    }

    // Fixed + body portal escapes chrome view-transition stacking so the
    // opaque panel paints above the sticky writing TOC rail.
    function placePanel() {
      var r = trigger.getBoundingClientRect()
      panel.style.position = 'fixed'
      panel.style.top = Math.round(r.bottom + 6) + 'px'
      panel.style.right = Math.round(window.innerWidth - r.right) + 'px'
      panel.style.left = 'auto'
      panel.style.bottom = 'auto'
    }

    function clearPlace() {
      panel.style.position = ''
      panel.style.top = ''
      panel.style.right = ''
      panel.style.left = ''
      panel.style.bottom = ''
    }

    function cancelLeave() {
      if (leaveTimer) {
        clearTimeout(leaveTimer)
        leaveTimer = 0
      }
    }

    function open(opts) {
      opts = opts || {}
      cancelLeave()
      if (animTimer) {
        clearTimeout(animTimer)
        animTimer = 0
      }
      if (opts.pin) setPinned(true)
      if (isOpen()) {
        placePanel()
        return
      }
      document.body.appendChild(panel)
      panel.hidden = false
      placePanel()
      trigger.setAttribute('aria-expanded', 'true')
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          panel.classList.add('is-open')
          if (opts.focus) {
            var first = panel.querySelector('[role="menuitem"]')
            if (first) first.focus()
          }
        })
      })
    }

    function finishClose(restoreFocus) {
      panel.classList.remove('is-open')
      panel.hidden = true
      clearPlace()
      if (panel.parentNode !== root) root.appendChild(panel)
      trigger.setAttribute('aria-expanded', 'false')
      setPinned(false)
      if (restoreFocus !== false) trigger.focus()
    }

    function close(restoreFocus) {
      cancelLeave()
      if (!isOpen()) {
        setPinned(false)
        return
      }
      panel.classList.remove('is-open')
      trigger.setAttribute('aria-expanded', 'false')
      setPinned(false)
      if (reduceMotion) {
        finishClose(restoreFocus)
        return
      }
      animTimer = window.setTimeout(function () {
        animTimer = 0
        panel.hidden = true
        clearPlace()
        if (panel.parentNode !== root) root.appendChild(panel)
        if (restoreFocus !== false) trigger.focus()
      }, 180)
    }

    function scheduleHoverClose() {
      if (pinned) return
      cancelLeave()
      // Bridge the 6px gap between trigger and portaled panel.
      leaveTimer = window.setTimeout(function () {
        leaveTimer = 0
        if (!pinned) close(false)
      }, 160)
    }

    // Click pins (or toggles pin off). Touch devices land here with no hover.
    trigger.addEventListener('click', function (e) {
      e.stopPropagation()
      cancelLeave()
      if (pinned) {
        close()
        return
      }
      if (isOpen()) {
        setPinned(true)
        return
      }
      open({ pin: true, focus: true })
    })

    if (hoverCapable) {
      trigger.addEventListener('mouseenter', function () {
        open({ focus: false })
      })
      trigger.addEventListener('mouseleave', scheduleHoverClose)
      panel.addEventListener('mouseenter', cancelLeave)
      panel.addEventListener('mouseleave', scheduleHoverClose)
    }

    document.addEventListener('click', function (e) {
      if (!isOpen()) return
      if (root.contains(e.target) || panel.contains(e.target)) return
      close(false)
    })

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen()) {
        e.preventDefault()
        close()
      }
    })

    window.addEventListener(
      'resize',
      function () {
        if (isOpen()) placePanel()
      },
      { passive: true },
    )

    panel.addEventListener('keydown', function (e) {
      var items = Array.prototype.slice.call(panel.querySelectorAll('[role="menuitem"]'))
      if (!items.length) return
      var i = items.indexOf(document.activeElement)
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        items[(i + 1) % items.length].focus()
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        items[(i - 1 + items.length) % items.length].focus()
      } else if (e.key === 'Home') {
        e.preventDefault()
        items[0].focus()
      } else if (e.key === 'End') {
        e.preventDefault()
        items[items.length - 1].focus()
      }
    })
  })()
</script>
