---

<div class="socials-menu" data-socials-menu>
  <button
    type="button"
    class="socials-menu-trigger"
    id="socialsMenuTrigger"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="socialsMenu"
    aria-label="Social links"
    title="Social links"
  >
    {/* Share / connect nodes — matches theme-toggle footprint */}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"
      />
    </svg>
  </button>
  <div class="socials-menu-panel" id="socialsMenu" role="menu" hidden>
    {
      socialLinks.map((item) => (
        <a
          class="socials-menu-item"
          role="menuitem"
          href={item.href}
          data-icon={item.id}
          {...(item.href.startsWith('http')
            ? { target: '_blank', rel: 'noopener noreferrer' }
            : {})}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d={iconPaths[item.id]} />
          </svg>
          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
</div>

<script is:inline>
  ;(function () {
    var root = document.querySelector('[data-socials-menu]')
    if (!root) return
    var trigger = root.querySelector('.socials-menu-trigger')
    var panel = root.querySelector('.socials-menu-panel')
    if (!trigger || !panel) return

    function isOpen() {
      return trigger.getAttribute('aria-expanded') === 'true'
    }

    function open() {
      panel.hidden = false
      trigger.setAttribute('aria-expanded', 'true')
      var first = panel.querySelector('[role="menuitem"]')
      if (first) first.focus()
    }

    function close(restoreFocus) {
      if (!isOpen()) return
      panel.hidden = true
      trigger.setAttribute('aria-expanded', 'false')
      if (restoreFocus !== false) trigger.focus()
    }

    function toggle() {
      if (isOpen()) close()
      else open()
    }

    trigger.addEventListener('click', function (e) {
      e.stopPropagation()
      toggle()
    })

    document.addEventListener('click', function (e) {
      if (!isOpen()) return
      if (root.contains(e.target)) return
      close(false)
    })

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen()) {
        e.preventDefault()
        close()
      }
    })

    // Arrow keys within the open menu
    panel.addEventListener('keydown', function (e) {
      var items = Array.prototype.slice.call(panel.querySelectorAll('[role="menuitem"]'))
      if (!items.length) return
      var i = items.indexOf(document.activeElement)
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        items[(i + 1) % items.length].focus()
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        items[(i - 1 + items.length) % items.length].focus()
      } else if (e.key === 'Home') {
        e.preventDefault()
        items[0].focus()
      } else if (e.key === 'End') {
        e.preventDefault()
        items[items.length - 1].focus()
      }
    })
  })()
</script>
