---
import { site } from '../lib/site'

type Props = {
  path?: string
}

const { path = '/' } = Astro.props
const wordmark = `@${site.github.name}`
---

<header class="chrome">
  <a class="wordmark" href="/">{wordmark}</a>
  <div class="chrome-end">
    <nav class="nav" aria-label="Primary">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
      <a
        href="/projects/"
        aria-current={path.startsWith('/projects') ? 'page' : undefined}
        >Projects</a
      >
      <a
        href="/writing/"
        aria-current={path.startsWith('/writing') ? 'page' : undefined}
        >Writing</a
      >
    </nav>
    <button
      type="button"
      class="theme-toggle"
      id="themeToggle"
      aria-label="Switch to light mode"
      title="Switch to light mode"
    >
      <span class="theme-icon theme-icon-sun" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path
            fill="currentColor"
            d="M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0-5a1 1 0 0 1 1 1v1.5a1 1 0 1 1-2 0V3a1 1 0 0 1 1-1zm0 17a1 1 0 0 1 1 1v1.5a1 1 0 1 1-2 0V20a1 1 0 0 1 1-1zM3 11a1 1 0 0 1 1-1h1.5a1 1 0 1 1 0 2H4a1 1 0 0 1-1-1zm15.5 0a1 1 0 0 1 1-1H21a1 1 0 1 1 0 2h-1.5a1 1 0 0 1-1-1zM5.64 5.64a1 1 0 0 1 1.41 0l1.06 1.06a1 1 0 1 1-1.41 1.41L5.64 7.05a1 1 0 0 1 0-1.41zm10.25 10.25a1 1 0 0 1 1.41 0l1.06 1.06a1 1 0 0 1-1.41 1.41l-1.06-1.06a1 1 0 0 1 0-1.41zM18.36 5.64a1 1 0 0 1 0 1.41l-1.06 1.06a1 1 0 1 1-1.41-1.41l1.06-1.06a1 1 0 0 1 1.41 0zM7.05 16.95a1 1 0 0 1 0 1.41l-1.06 1.06a1 1 0 1 1-1.41-1.41l1.06-1.06a1 1 0 0 1 1.41 0z"
          />
        </svg>
      </span>
      <span class="theme-icon theme-icon-moon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path
            fill="currentColor"
            d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"
          />
        </svg>
      </span>
    </button>
    {/* Align label with any theme the head script already applied. */}
    <script is:inline>
      ;(function () {
        var toggle = document.getElementById('themeToggle')
        if (!toggle) return
        var light = document.documentElement.getAttribute('data-theme') === 'light'
        var label = light ? 'Switch to dark mode' : 'Switch to light mode'
        toggle.setAttribute('aria-label', label)
        toggle.setAttribute('title', label)
      })()
    </script>
  </div>
</header>
