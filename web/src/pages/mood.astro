---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageIntro from '../components/PageIntro.astro'
import { site } from '../lib/site'

const moods = (site.moods ?? []).filter((m) => Boolean(m.src))
---

<BaseLayout
  title="Moods"
  description="Moods that appear on the home page, one at a time."
  path="/mood/"
  robots="noindex, nofollow"
>
  <noscript>
    <style>
      .mood-index-img {
        opacity: 1;
        transform: none;
      }
    </style>
  </noscript>
  <div class="page">
    <PageIntro eyebrow="Moods" title="Stills from the home plate">
      These moods appear on the home page, one&nbsp;at&nbsp;a&nbsp;time.
    </PageIntro>

    {
      moods.length ? (
        <ul class="mood-index-grid reveal" style="--i: 1">
          {moods.map((mood, i) => (
            <li style={`--i: ${i}`}>
              <a class="mood-index-link" href={`/?mood=${mood.id}`}>
                <div class="mood-index-frame mood-inset">
                  <img
                    class="mood-index-img"
                    src={mood.src}
                    alt={mood.alt || mood.id}
                    loading="lazy"
                    decoding="async"
                    width="720"
                    height="1280"
                  />
                </div>
                <span class="mood-index-id">{mood.id}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No moods configured.</p>
      )
    }
  </div>
  {/* Soft fade once each still decodes — same ease family as home mood settle. */}
  <script is:inline>
    ;(function () {
      document.querySelectorAll('.mood-index-img').forEach(function (img) {
        var show = function () {
          img.classList.add('is-loaded')
        }
        if (img.complete && img.naturalWidth > 0) {
          show()
          return
        }
        img.addEventListener('load', show, { once: true })
        img.addEventListener('error', show, { once: true })
        if (img.complete) show()
      })
    })()
  </script>
</BaseLayout>
