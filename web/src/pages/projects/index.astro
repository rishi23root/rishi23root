---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageIntro from '../../components/PageIntro.astro'
import { getOrderedProjects, getProjectTags, normalizeProjectTags } from '../../lib/site'

const PROJECT_FILTER_MIN = 10

const rawProjects = getOrderedProjects().map((project) => ({
  ...project,
  normalizedTags: normalizeProjectTags(project.tags),
}))
const tags = getProjectTags(rawProjects)
const shownTags = new Set(tags.map(({ tag }) => tag))
const projects = rawProjects.map((project) => ({
  ...project,
  displayTags: project.normalizedTags.filter((tag) => shownTags.has(tag)),
}))
const showFilters = projects.length >= PROJECT_FILTER_MIN
---

<BaseLayout
  title="Projects"
  description="Selected work — open source, automation, and product surfaces."
  path="/projects/"
>
  {showFilters ? <noscript><style>[data-project-filters]{display:none}</style></noscript> : null}
  <div class="page blog-page page-listing">
    <PageIntro eyebrow="Projects" title="Selected work">
      Open source, automation, and product surfaces I've shipped.
    </PageIntro>

    {
      projects.length ? (
        <>
          {showFilters ? (
            <div class="project-filters reveal" style="--i: 1" data-project-filters>
              <div class="project-search-row">
                <input
                  type="search"
                  class="project-search"
                  placeholder="Search projects…"
                  aria-label="Search projects"
                  autocomplete="off"
                  spellcheck="false"
                  data-project-search
                />
                <span class="project-count" aria-live="polite" data-project-count>
                  {projects.length} {projects.length === 1 ? 'project' : 'projects'}
                </span>
              </div>

              {tags.length ? (
                <div class="project-tag-bar" role="group" aria-label="Filter projects by tag">
                  <button
                    type="button"
                    class="project-tag-pill is-active"
                    data-project-tag=""
                    aria-pressed="true"
                  >
                    all<span class="project-tag-count">{projects.length}</span>
                  </button>
                  {tags.map(({ tag, count }) => (
                    <button
                      type="button"
                      class="project-tag-pill"
                      data-project-tag={tag}
                      aria-pressed="false"
                    >
                      {tag}<span class="project-tag-count">{count}</span>
                    </button>
                  ))}
                </div>
              ) : null}
            </div>
          ) : null}

          <ul
            class="post-list reveal"
            style={`--i: ${showFilters ? 2 : 1}`}
            data-project-list={showFilters ? '' : undefined}
          >
            {projects.map((project) => (
              <li
                class="post-list-item hover-row"
                data-project-item={showFilters ? '' : undefined}
                data-tags={showFilters ? JSON.stringify(project.displayTags) : undefined}
                data-search={
                  showFilters
                    ? [project.title, project.blurb ?? '', ...project.normalizedTags]
                        .join(' ')
                        .toLowerCase()
                    : undefined
                }
              >
                <div class="post-list-top">
                  <h2 class="post-list-heading">
                    <a class="row-link" href={project.url} rel="noopener noreferrer">
                      {project.title}
                    </a>
                  </h2>
                </div>
                {project.blurb ? <p class="post-list-summary">{project.blurb}</p> : null}
                {project.displayTags.length ? (
                  <p class="post-list-tags">{project.displayTags.join(' · ')}</p>
                ) : null}
              </li>
            ))}
          </ul>

          {showFilters ? (
            <p class="empty project-empty" hidden data-project-empty>
              No matching projects.{' '}
              <button type="button" class="project-reset" data-project-reset>
                Reset filters
              </button>
            </p>
          ) : null}
        </>
      ) : (
        <p class="empty">No projects yet.</p>
      )
    }
  </div>

  {
    showFilters ? (
      <script is:inline>
        ;(function () {
          var filtersRoot = document.querySelector('[data-project-filters]')
          var list = document.querySelector('[data-project-list]')
          if (!filtersRoot || !list) return

          var searchInput = filtersRoot.querySelector('[data-project-search]')
          var countEl = filtersRoot.querySelector('[data-project-count]')
          var tagButtons = Array.from(filtersRoot.querySelectorAll('[data-project-tag]'))
          var items = Array.from(list.querySelectorAll('[data-project-item]'))
          var emptyEl = document.querySelector('[data-project-empty]')
          var resetBtn = document.querySelector('[data-project-reset]')

          var validTags = new Set(
            tagButtons.map(function (btn) {
              return btn.dataset.projectTag || ''
            }),
          )
          var params = new URLSearchParams(window.location.search)
          var initialTag = (params.get('tag') || '').trim().toLowerCase()
          var activeTag = validTags.has(initialTag) ? initialTag : ''
          var query = (params.get('q') || '').trim()

          if (searchInput && query) {
            searchInput.value = query
          }

          function syncUrl() {
            var next = new URLSearchParams()
            if (activeTag) next.set('tag', activeTag)
            if (query) next.set('q', query)
            var qs = next.toString()
            var target = window.location.pathname + (qs ? '?' + qs : '') + window.location.hash
            window.history.replaceState(null, '', target)
          }

          function apply(updateUrl) {
            var tokens = query.toLowerCase().split(/\s+/).filter(Boolean)
            var shown = 0

            for (var i = 0; i < items.length; i++) {
              var item = items[i]
              var itemTags = JSON.parse(item.dataset.tags || '[]')
              var itemSearch = item.dataset.search || ''
              var tagMatch = !activeTag || itemTags.indexOf(activeTag) !== -1
              var queryMatch =
                !tokens.length ||
                tokens.every(function (token) {
                  return itemSearch.indexOf(token) !== -1
                })
              var match = tagMatch && queryMatch
              item.hidden = !match
              if (match) shown++
            }

            for (var j = 0; j < tagButtons.length; j++) {
              var btn = tagButtons[j]
              var isCurrent = (btn.dataset.projectTag || '') === activeTag
              btn.classList.toggle('is-active', isCurrent)
              btn.setAttribute('aria-pressed', String(isCurrent))
            }

            if (countEl) {
              var total = items.length
              countEl.textContent =
                activeTag || tokens.length
                  ? shown + ' of ' + total
                  : total + (total === 1 ? ' project' : ' projects')
            }

            if (emptyEl) {
              emptyEl.hidden = shown > 0
            }

            if (updateUrl) syncUrl()
          }

          tagButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
              activeTag = btn.dataset.projectTag || ''
              apply(true)
            })
          })

          if (searchInput) {
            searchInput.addEventListener('input', function () {
              query = searchInput.value.trim()
              apply(true)
            })

            searchInput.addEventListener('keydown', function (event) {
              if (event.key === 'Escape' && searchInput.value) {
                searchInput.value = ''
                query = ''
                apply(true)
              }
            })
          }

          if (resetBtn) {
            resetBtn.addEventListener('click', function () {
              activeTag = ''
              query = ''
              if (searchInput) searchInput.value = ''
              apply(true)
              if (searchInput) searchInput.focus()
            })
          }

          apply(false)
        })()
      </script>
    ) : null
  }
</BaseLayout>
