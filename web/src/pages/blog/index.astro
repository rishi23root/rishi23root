---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { publishedPostsFilter } from '../../lib/site'

const posts = (await getCollection('posts', publishedPostsFilter)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
---

<BaseLayout
  title="Writing"
  description="Notes on SaaS, automation, and security."
  path="/blog"
>
  <div class="page">
    <section class="page-intro">
      <h1>Writing</h1>
      <p class="lede">Short notes. Same posts tree as the profile README.</p>
    </section>

    {
      posts.length ? (
        <ul class="quiet-list">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.data.slug}`}>{post.data.title}</a>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toISOString().slice(0, 10)}
              </time>
              {post.data.summary ? (
                <span class="meta">— {post.data.summary}</span>
              ) : null}
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No posts yet.</p>
      )
    }
  </div>
</BaseLayout>
