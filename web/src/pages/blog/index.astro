---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { publishedPostsFilter } from '../../lib/site'

const posts = (await getCollection('posts', publishedPostsFilter)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
---

<BaseLayout
  title="Blog"
  description="Notes on SaaS, automation, and security."
  path="/blog"
>
  <section class="hero">
    <p class="prompt">$ ls blog/</p>
    <h1>Writing</h1>
    <p class="lede">Short notes. Same content tree as the profile README.</p>
  </section>

  {
    posts.length ? (
      <ul class="list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.data.slug}`}>{post.data.title}</a>
            <span class="meta">
              {post.data.date.toISOString().slice(0, 10)}
              {post.data.summary ? ` — ${post.data.summary}` : ''}
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">No posts yet.</p>
    )
  }
</BaseLayout>
