---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Not found"
  description="This page isn't here."
  path="/404/"
  robots="noindex, nofollow"
>
  <div class="lost">
    <svg
      class="lost-scene"
      viewBox="0 0 1440 900"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <linearGradient id="lost-sky" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#07080c"></stop>
          <stop offset="62%" stop-color="#121820"></stop>
          <stop offset="100%" stop-color="#24343f"></stop>
        </linearGradient>
        <linearGradient id="lost-sea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#2a5364"></stop>
          <stop offset="12%" stop-color="#163848"></stop>
          <stop offset="46%" stop-color="#0c1e2a"></stop>
          <stop offset="100%" stop-color="#070b10"></stop>
        </linearGradient>
        <radialGradient id="lost-halo" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#f4efe4" stop-opacity="0.5"></stop>
          <stop offset="42%" stop-color="#f4efe4" stop-opacity="0.1"></stop>
          <stop offset="100%" stop-color="#f4efe4" stop-opacity="0"></stop>
        </radialGradient>
        <linearGradient id="lost-horizon" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#d5ecf4" stop-opacity="0"></stop>
          <stop offset="50%" stop-color="#d5ecf4" stop-opacity="0.22"></stop>
          <stop offset="100%" stop-color="#d5ecf4" stop-opacity="0"></stop>
        </linearGradient>
      </defs>

      <rect width="1440" height="900" fill="url(#lost-sky)"></rect>

      <g fill="#f4efe4">
        <circle cx="150" cy="96" r="1.05" opacity="0.7"></circle>
        <circle cx="280" cy="180" r="0.6" opacity="0.4"></circle>
        <circle cx="460" cy="64" r="0.85" opacity="0.55"></circle>
        <circle cx="610" cy="150" r="0.55" opacity="0.35"></circle>
        <circle cx="980" cy="78" r="1.15" opacity="0.6"></circle>
        <circle cx="1160" cy="140" r="0.7" opacity="0.45"></circle>
        <circle cx="1300" cy="56" r="0.9" opacity="0.5"></circle>
      </g>

      <circle cx="800" cy="168" r="92" fill="url(#lost-halo)"></circle>
      <circle cx="800" cy="168" r="26" fill="#f3eee4"></circle>

      <path
        fill="url(#lost-sea)"
        d="M0 468C220 446 380 488 620 458C860 428 1040 486 1280 450C1360 438 1410 446 1440 442V900H0Z"
      ></path>
      <rect x="0" y="410" width="1440" height="90" fill="url(#lost-horizon)"></rect>

      <g fill="none" stroke="#d7eef6" stroke-linecap="round">
        <path d="M900 548C1080 530 1240 566 1420 540" stroke-width="1.25" opacity="0.32"></path>
        <path d="M820 640C1020 622 1220 668 1420 636" stroke-width="1.1" opacity="0.2"></path>
      </g>

      <g fill="#f3eee4">
        <ellipse cx="802" cy="498" rx="3" ry="10" opacity="0.7"></ellipse>
        <ellipse cx="792" cy="534" rx="11" ry="4" opacity="0.42"></ellipse>
        <ellipse cx="812" cy="568" rx="5" ry="3.5" opacity="0.34"></ellipse>
        <ellipse cx="786" cy="608" rx="16" ry="4.5" opacity="0.28"></ellipse>
        <ellipse cx="808" cy="652" rx="7" ry="3" opacity="0.2"></ellipse>
        <ellipse cx="778" cy="700" rx="20" ry="4" opacity="0.16"></ellipse>
        <ellipse cx="816" cy="748" rx="8" ry="3" opacity="0.12"></ellipse>
      </g>
    </svg>

    <div class="lost-copy reveal" style="--i: 1">
      <p class="page-eyebrow">Lost</p>
      <h1>This page isn't here.</h1>
      <p class="lost-lede">
        You kept walking past the last page. The rest of the site is still where you left it.
      </p>
      <a class="lost-home" href="/">Home</a>
    </div>
  </div>
</BaseLayout>
