---
import BaseLayout from '../layouts/BaseLayout.astro'

const photo = '/lost/earth.webp'
---

<BaseLayout
  title="Not found"
  description="This page isn't here."
  path="/404/"
  robots="noindex, nofollow"
>
  <link slot="head" rel="preload" as="image" href={photo} type="image/webp" fetchpriority="high" />
  <div class="lost">
    <img
      class="lost-photo"
      src={photo}
      alt=""
      width="736"
      height="1307"
      fetchpriority="high"
      decoding="async"
    />
    <div class="lost-copy reveal" style="--i: 1">
      <p class="page-eyebrow">Lost</p>
      <h1>This page isn't here.</h1>
      <p class="lost-lede">
        You kept walking past the last page. The rest of the site is still where you left it.
      </p>
      <a class="lost-home" href="/">Home</a>
    </div>
  </div>
</BaseLayout>
