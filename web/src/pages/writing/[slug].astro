---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ContactIcons from '../../components/ContactIcons.astro'
import Callout from '../../components/Callout.astro'
import {
  assertSlugMatchesFile,
  formatPostDate,
  postKeywords,
  publishedPostsFilter,
  readingTimeMinutes,
  site,
} from '../../lib/site'

export async function getStaticPaths() {
  const posts = await getCollection('posts', publishedPostsFilter)
  posts.forEach(assertSlugMatchesFile)
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const d = post.data
const path = `/writing/${d.slug}`
const canonical = new URL(path, site.siteUrl).toString()
const ogImage = d.image ?? d.cover ?? '/og-default.png'
const ogImageAbsolute = new URL(ogImage, site.siteUrl).toString()
const minutes = readingTimeMinutes(post.body, d.faq)
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const keywords = postKeywords(d)
const author = { '@type': 'Person', name: d.author, alternateName: site.github.name, url: site.siteUrl }

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.summary,
    datePublished: d.date.toISOString(),
    ...(d.updated ? { dateModified: d.updated.toISOString() } : {}),
    url: canonical,
    mainEntityOfPage: canonical,
    image: ogImageAbsolute,
    ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
    author,
    publisher: author,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Writing', item: new URL('/writing', site.siteUrl).toString() },
      { '@type': 'ListItem', position: 3, name: d.title, item: canonical },
    ],
  },
]
if (d.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })
}
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.summary}
  path={path}
  type="article"
  publishedTime={d.date}
  image={ogImage}
  jsonLd={jsonLd}
>
  <div class="page blog-page post-page">
    <div class="post-layout">
      <article class="post reveal" style="--i: 0" data-longform>
        <nav class="post-crumbs" aria-label="Breadcrumb">
          <a href="/writing">Writing</a>
          <span aria-hidden="true">/</span>
          <span class="post-crumbs-current">{d.title}</span>
        </nav>

        <header class="post-header">
          <h1>{d.title}</h1>
          <p class="post-deck">{d.summary}</p>
          <p class="post-meta">
            <span>{d.author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={d.date.toISOString()}>{formatPostDate(d.date)}</time>
            {
              d.updated ? (
                <>
                  <span aria-hidden="true">·</span>
                  <span>Updated {formatPostDate(d.updated)}</span>
                </>
              ) : null
            }
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
            {
              d.draft ? (
                <>
                  <span aria-hidden="true">·</span>
                  <span class="post-draft">Draft</span>
                </>
              ) : null
            }
          </p>
          {d.tags.length ? <p class="post-tags">{d.tags.join(' · ')}</p> : null}
        </header>

        {
          d.cover ? (
            <figure class="post-cover">
              <img src={d.cover} alt={`Cover for ${d.title}`} decoding="async" />
            </figure>
          ) : null
        }

        <div class="prose post-body">
          <Content components={{ Callout }} />
        </div>

        {
          d.faq.length ? (
            <section class="post-faq" aria-labelledby="faq">
              <h2 id="faq">FAQ</h2>
              <dl>
                {d.faq.map((f) => (
                  <div>
                    <dt>{f.q}</dt>
                    <dd>{f.a}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ) : null
        }
      </article>

      <aside class="post-rail" aria-label="Page tools">
        <div class="post-rail-sticky">
          {
            toc.length ? (
              <nav class="post-toc" aria-label="On this page">
                <p class="post-rail-label">On this page</p>
                <ul>
                  {toc.map((h) => (
                    <li class:list={[`toc-depth-${h.depth}`]}>
                      <a href={`#${h.slug}`} data-toc={h.slug}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                  {d.faq.length ? (
                    <li class="toc-depth-2">
                      <a href="#faq" data-toc="faq">
                        FAQ
                      </a>
                    </li>
                  ) : null}
                </ul>
              </nav>
            ) : null
          }
          <div class="post-rail-tools">
            <button type="button" class="post-progress" id="postProgress" title="Back to top">
              <svg viewBox="0 0 36 36" aria-hidden="true">
                <circle cx="18" cy="18" r="14" class="post-progress-track" />
                <circle cx="18" cy="18" r="14" class="post-progress-bar" />
              </svg>
              <span class="post-progress-pct">0%</span>
            </button>
            <button type="button" class="post-pill" id="postShare">Share</button>
            <a class="post-pill" href="/writing">All writing</a>
          </div>
        </div>
      </aside>
    </div>

    <ContactIcons />
  </div>

  <script is:inline>
    ;(function () {
      var root = document.querySelector('[data-longform]')
      var btn = document.getElementById('postProgress')
      if (!root || !btn) return
      var bar = btn.querySelector('.post-progress-bar')
      var pct = btn.querySelector('.post-progress-pct')
      var C = 2 * Math.PI * 14
      if (bar) bar.style.strokeDasharray = String(C)
      var links = Array.prototype.slice.call(document.querySelectorAll('[data-toc]'))
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      function sync() {
        var r = root.getBoundingClientRect()
        var top = window.scrollY + r.top
        var start = top - 96
        var end = top + root.offsetHeight - window.innerHeight * 0.4
        var p = Math.min(100, Math.max(0, Math.round(((window.scrollY - start) / Math.max(1, end - start)) * 100)))
        if (bar) bar.style.strokeDashoffset = String(C * (1 - p / 100))
        if (pct) pct.textContent = p + '%'
        btn.setAttribute('aria-label', 'Reading progress ' + p + ' percent. Back to top.')
        var marker = window.innerHeight * 0.28
        var current = null
        links.forEach(function (a) {
          var el = document.getElementById(a.getAttribute('data-toc'))
          if (el && el.getBoundingClientRect().top <= marker) current = a
        })
        links.forEach(function (a) {
          a.toggleAttribute('aria-current', a === current)
        })
      }
      sync()
      window.addEventListener('scroll', sync, { passive: true })
      window.addEventListener('resize', sync)
      btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' })
      })

      var share = document.getElementById('postShare')
      if (share) {
        share.addEventListener('click', function () {
          var data = { title: document.title, url: location.href }
          if (navigator.share) {
            navigator.share(data).catch(function () {})
            return
          }
          navigator.clipboard &&
            navigator.clipboard.writeText(location.href).then(
              function () {
                share.textContent = 'Copied'
                setTimeout(function () {
                  share.textContent = 'Share'
                }, 1800)
              },
              function () {},
            )
        })
      }
    })()
  </script>
</BaseLayout>
