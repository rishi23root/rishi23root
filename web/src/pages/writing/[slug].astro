---
import { render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Callout from '../../components/Callout.astro'
import ContactIcons from '../../components/ContactIcons.astro'
import MetaLine from '../../components/MetaLine.astro'
import { absoluteUrl, site } from '../../lib/site'
import {
  assertSlugMatchesFile,
  formatPostDate,
  getPublishedPosts,
  postKeywords,
  postPath,
  readingTimeMinutes,
  type Post,
} from '../../lib/posts'
import { publicImageSize } from '../../lib/imageSize'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  posts.forEach(assertSlugMatchesFile)
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }))
}

const { post } = Astro.props as { post: Post }
const { Content, headings } = await render(post)
const d = post.data
const path = postPath(d.slug)
const canonical = absoluteUrl(path)
const ogImage = d.image ?? d.cover ?? '/og-default.png'
const coverSize = d.cover ? publicImageSize(d.cover) : undefined
// Rail outline: each H2 owns the H3s that follow it. H3s before the first H2
// have no parent, so they stay top-level and always visible.
type TocLink = { slug: string; text: string }
type TocGroup = TocLink & { depth: 2 | 3; children: TocLink[] }
const toc: TocGroup[] = []
for (const h of headings) {
  if (h.depth === 2) toc.push({ slug: h.slug, text: h.text, depth: 2, children: [] })
  else if (h.depth === 3) {
    const parent = toc.at(-1)
    if (parent?.depth === 2) parent.children.push({ slug: h.slug, text: h.text })
    else toc.push({ slug: h.slug, text: h.text, depth: 3, children: [] })
  }
}
if (d.faq.length) toc.push({ slug: 'faq', text: 'FAQ', depth: 2, children: [] })
const keywords = postKeywords(post)
const author = { '@type': 'Person', name: d.author, alternateName: site.github.name, url: site.siteUrl }

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.summary,
    datePublished: d.date.toISOString(),
    ...(d.updated ? { dateModified: d.updated.toISOString() } : {}),
    url: canonical,
    mainEntityOfPage: canonical,
    image: absoluteUrl(ogImage),
    ...(keywords.length ? { keywords: keywords.join(', ') } : {}),
    author,
    publisher: author,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Writing', item: absoluteUrl('/writing') },
      { '@type': 'ListItem', position: 3, name: d.title, item: canonical },
    ],
  },
]
if (d.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  })
}
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.summary}
  path={path}
  type="article"
  publishedTime={d.date}
  image={ogImage}
  jsonLd={jsonLd}
>
  <noscript>
    <style>
      .post-cover img,
      .post-body img {
        opacity: 1;
      }
    </style>
  </noscript>
  <div class="page blog-page">
    <div class="post-layout">
      <article class="post reveal" style="--i: 0" data-longform>
        <nav class="post-crumbs" aria-label="Breadcrumb">
          <a href="/writing">Writing</a>
          <span aria-hidden="true">/</span>
          <span class="post-crumbs-current">{d.title}</span>
        </nav>

        <header class="post-header">
          <h1>{d.title}</h1>
          <p class="post-deck">{d.summary}</p>
          <MetaLine
            class="post-meta"
            items={[
              { text: d.author },
              { text: formatPostDate(d.date), datetime: d.date.toISOString() },
              d.updated && { text: `Updated ${formatPostDate(d.updated)}` },
              { text: `${readingTimeMinutes(post)} min read` },
              d.draft && { text: 'Draft', class: 'post-draft' },
            ]}
          />
          {
            d.tags.length ? (
              <ul class="post-tags" aria-label="Tags">
                {d.tags.map((t) => (
                  <li class="post-tag">{t}</li>
                ))}
              </ul>
            ) : null
          }
        </header>

        {
          d.cover ? (
            <figure class="post-cover">
              <img
                src={d.cover}
                alt={`Cover for ${d.title}`}
                width={coverSize?.width}
                height={coverSize?.height}
                decoding="async"
                fetchpriority="high"
              />
            </figure>
          ) : null
        }

        <div class="prose post-body">
          <Content components={{ Callout }} />
        </div>

        {
          d.faq.length ? (
            <section class="post-faq" aria-labelledby="faq">
              <h2 id="faq">FAQ</h2>
              <dl>
                {d.faq.map((f) => (
                  <div>
                    <dt>{f.q}</dt>
                    <dd>{f.a}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ) : null
        }
      </article>

      <aside class="post-rail" aria-label="Page tools">
        <div class="post-rail-sticky">
          {
            toc.length ? (
              <nav class="post-toc" aria-label="On this page">
                <p class="post-rail-label">On this page</p>
                <ul>
                  {toc.map((g) => (
                    <li class={`toc-depth-${g.depth}`}>
                      <a href={`#${g.slug}`} data-toc={g.slug}>
                        {g.text}
                      </a>
                      {g.children.length ? (
                        <div class="toc-sub" data-toc-sub>
                          <ul>
                            {g.children.map((c) => (
                              <li class="toc-depth-3">
                                <a href={`#${c.slug}`} data-toc={c.slug}>
                                  {c.text}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ) : null}
                    </li>
                  ))}
                </ul>
              </nav>
            ) : null
          }
          <div class="post-rail-tools">
            <button type="button" class="post-progress" id="postProgress" title="Back to top">
              <span class="post-progress-ring">
                <svg viewBox="0 0 36 36" aria-hidden="true">
                  <circle cx="18" cy="18" r="14" class="post-progress-track" />
                  <circle cx="18" cy="18" r="14" class="post-progress-bar" />
                </svg>
                <span class="post-progress-pct">0%</span>
              </span>
              <span class="post-progress-label">↑ Back to top</span>
            </button>
            <button type="button" class="post-tool" id="postShare" aria-label="Share this post">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4" /></svg>
              <span class="post-tool-label" id="postShareLabel">Share</span>
            </button>
            <a class="post-tool" href="/writing" aria-label="All writing">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h16M4 19h10" /></svg>
              <span class="post-tool-label">All writing</span>
            </a>
            <a class="post-tool" href="/" aria-label="Home">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 4l9 7" /><path d="M5 10v10h14V10" /></svg>
              <span class="post-tool-label">Home</span>
            </a>
          </div>
        </div>
      </aside>
    </div>

    <ContactIcons />
  </div>

  <script is:inline>
    ;(function () {
      var root = document.querySelector('[data-longform]')
      if (!root) return
      // Fade each post image in once it has decoded. Already-complete
      // (cached) images get .is-loaded now so they never hide-then-fade.
      root.querySelectorAll('.post-cover img, .post-body img').forEach(function (img) {
        var show = function () {
          img.classList.add('is-loaded')
        }
        if (img.complete && img.naturalWidth > 0) {
          show()
          return
        }
        img.addEventListener('load', show, { once: true })
        img.addEventListener('error', show, { once: true })
        if (img.complete) show()
      })
      var btn = document.getElementById('postProgress')
      if (!btn) return
      var bar = btn.querySelector('.post-progress-bar')
      var pct = btn.querySelector('.post-progress-pct')
      var ring = 2 * Math.PI * 14 // circumference; r=14 in the SVG
      if (bar) bar.style.strokeDasharray = String(ring)
      var links = Array.prototype.slice.call(document.querySelectorAll('[data-toc]'))
      var motion = window.matchMedia('(prefers-reduced-motion: reduce)')
      var toc = document.querySelector('.post-toc')
      var subs = Array.prototype.slice.call(document.querySelectorAll('[data-toc-sub]'))
      // Each link's group: an H3's nested list, or the list an H2 owns.
      function groupOf(a) {
        if (!a) return null
        return a.closest('[data-toc-sub]') || (a.parentElement && a.parentElement.querySelector(':scope > [data-toc-sub]'))
      }
      var openSub = null
      function setOpen(sub) {
        if (sub === openSub) return
        openSub = sub
        subs.forEach(function (s) {
          var on = s === sub
          s.classList.toggle('is-open', on)
          s.inert = !on
        })
      }
      // Collapse only once JS can reopen them; without JS every H3 stays listed.
      if (toc && subs.length) {
        subs.forEach(function (s) {
          s.inert = true
        })
        toc.classList.add('is-collapsible')
      }
      var pinned = null // link chosen by a rail click, held while its heading is still on screen
      var pinnedY = 0
      var animating = false

      function sync() {
        var r = root.getBoundingClientRect()
        var top = window.scrollY + r.top
        var start = top - 96
        var end = top + root.offsetHeight - window.innerHeight * 0.4
        var p = Math.min(100, Math.max(0, Math.round(((window.scrollY - start) / Math.max(1, end - start)) * 100)))
        if (bar) bar.style.strokeDashoffset = String(ring * (1 - p / 100))
        if (pct) pct.textContent = p + '%'
        btn.setAttribute('aria-label', 'Reading progress ' + p + ' percent. Back to top.')
        if (animating) return
        var current = null
        if (pinned && Math.abs(window.scrollY - pinnedY) < 4) current = pinned
        else {
          pinned = null
          var marker = window.innerHeight * 0.28
          links.forEach(function (a) {
            var el = document.getElementById(a.getAttribute('data-toc'))
            if (el && el.getBoundingClientRect().top <= marker) current = a
          })
        }
        setCurrent(current)
      }
      function setCurrent(current) {
        links.forEach(function (a) {
          a.toggleAttribute('aria-current', a === current)
        })
        setOpen(groupOf(current))
      }
      sync()
      window.addEventListener('scroll', sync, { passive: true })
      window.addEventListener('resize', sync)
      btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: motion.matches ? 'auto' : 'smooth' })
      })

      // Rail clicks: eased scroll to the heading (instant with reduced motion).
      // The clicked item is marked current up front so the rail doesn't flicker
      // through every section on the way.
      var raf = 0
      function ease(t) {
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2
      }
      function stop() {
        if (!animating) return
        cancelAnimationFrame(raf)
        animating = false
        pinned = null
        sync()
      }
      ;['wheel', 'touchstart', 'keydown', 'mousedown'].forEach(function (type) {
        window.addEventListener(type, stop, { passive: true })
      })
      function scrollToHeading(a, el) {
        var margin = parseFloat(getComputedStyle(el).scrollMarginTop) || 0
        var max = document.documentElement.scrollHeight - window.innerHeight
        var to = Math.max(0, Math.min(max, Math.round(window.scrollY + el.getBoundingClientRect().top - margin)))
        var from = window.scrollY
        var done = function () {
          animating = false
          pinned = a
          pinnedY = window.scrollY
          if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '-1')
          el.focus({ preventScroll: true })
        }
        cancelAnimationFrame(raf)
        setCurrent(a)
        var dist = Math.abs(to - from)
        if (motion.matches || dist < 2) {
          window.scrollTo(0, to)
          done()
          return
        }
        var dur = Math.min(800, 480 + dist * 0.08)
        var t0 = 0
        animating = true
        raf = requestAnimationFrame(function step(now) {
          if (!t0) t0 = now
          var t = Math.min(1, (now - t0) / dur)
          window.scrollTo(0, from + (to - from) * ease(t))
          if (t < 1) raf = requestAnimationFrame(step)
          else done()
        })
      }
      links.forEach(function (a) {
        a.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
          var id = a.getAttribute('data-toc')
          var el = document.getElementById(id)
          if (!el) return
          e.preventDefault()
          history.replaceState(history.state, '', '#' + id)
          scrollToHeading(a, el)
        })
      })

      var share = document.getElementById('postShare')
      if (share) {
        share.addEventListener('click', function () {
          var data = { title: document.title, url: location.href }
          if (navigator.share) {
            navigator.share(data).catch(function () {})
            return
          }
          navigator.clipboard &&
            navigator.clipboard.writeText(location.href).then(
              function () {
                var lbl = document.getElementById('postShareLabel')
                share.classList.add('is-open')
                if (lbl) lbl.textContent = 'Link copied'
                setTimeout(function () {
                  share.classList.remove('is-open')
                  if (lbl) lbl.textContent = 'Share'
                }, 1800)
              },
              function () {},
            )
        })
      }
    })()
  </script>
</BaseLayout>
