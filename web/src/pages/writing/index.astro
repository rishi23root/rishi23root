---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ContactIcons from '../../components/ContactIcons.astro'
import { publishedPostsFilter } from '../../lib/site'

const posts = (await getCollection('posts', publishedPostsFilter)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
---

<BaseLayout
  title="Writing"
  description="Notes on SaaS, automation, and security."
  path="/writing"
>
  <div class="page blog-page">
    <section class="page-intro">
      <h1>Writing</h1>
      <p class="lede">Short notes. Same posts tree as the profile README.</p>
    </section>

    {
      posts.length ? (
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-list-item">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toISOString().slice(0, 10)}
              </time>
              <div class="post-list-body">
                <a class="post-list-title" href={`/writing/${post.data.slug}`}>
                  {post.data.title}
                </a>
                {post.data.summary ? (
                  <p class="post-list-summary">{post.data.summary}</p>
                ) : null}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No posts yet.</p>
      )
    }

    <ContactIcons />
  </div>
</BaseLayout>
