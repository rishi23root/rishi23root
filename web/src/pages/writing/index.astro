---
import BaseLayout from '../../layouts/BaseLayout.astro'
import MetaLine from '../../components/MetaLine.astro'
import PageIntro from '../../components/PageIntro.astro'
import { formatPostDate, getPublishedPosts, postPath, readingTimeMinutes } from '../../lib/posts'

const posts = await getPublishedPosts()
---

<BaseLayout title="Writing" description="Short notes on SaaS, automation, and security — written as I ship." path="/writing/">
  <div class="page blog-page page-listing">
    <PageIntro eyebrow="Writing" title="Notes from building">
      Short notes on SaaS, automation, and security — written as I ship.
    </PageIntro>

    {
      posts.length ? (
        <ul class="post-list reveal" style="--i: 1">
          {posts.map((post) => (
            <li class="post-list-item hover-row">
              <div class="post-list-top">
                <h2 class="post-list-heading">
                  <a class="row-link" href={postPath(post.data.slug)}>{post.data.title}</a>
                </h2>
                <MetaLine
                  class="post-list-meta"
                  items={[
                    { text: formatPostDate(post.data.date), datetime: post.data.date.toISOString() },
                    { text: `${readingTimeMinutes(post)} min read` },
                    post.data.draft && { text: 'Draft', class: 'post-draft' },
                  ]}
                />
              </div>
              <p class="post-list-summary">{post.data.summary}</p>
              {post.data.tags.length ? (
                <p class="post-list-tags">{post.data.tags.join(' · ')}</p>
              ) : null}
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No posts yet.</p>
      )
    }
  </div>
</BaseLayout>
