---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroMoodShell from '../components/HeroMoodShell'
import { githubAvatarUrl, publishedPostsFilter, site } from '../lib/site'

const posts = (await getCollection('posts', publishedPostsFilter)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

const projects = (site.projects ?? [])
  .slice()
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
  .slice(0, 6)

const capabilities = site.capabilities ?? []
const moods = site.moods ?? []
const voiceBio = site.voiceBio ?? site.fullDescription

const socials = [
  { label: 'Email', href: `mailto:${site.contact.email}` },
  { label: 'Website', href: site.contact.socials.website },
  { label: 'X', href: site.contact.socials.x },
  { label: 'LinkedIn', href: site.contact.socials.linkedin },
  { label: 'GitHub', href: site.contact.socials.github },
  { label: 'PyPI', href: site.contact.socials.pypi },
]

/** Avatar URL for schema/meta only — never rendered as on-page <img>. */
const avatarUrl = githubAvatarUrl(320)

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.github.name,
  url: site.siteUrl,
  email: site.contact.email,
  description: site.fullDescription,
  image: avatarUrl,
  sameAs: [
    site.contact.socials.website,
    site.contact.socials.x,
    site.contact.socials.linkedin,
    site.contact.socials.github,
    site.contact.socials.pypi,
  ],
}
---

<BaseLayout path="/" jsonLd={personJsonLd}>
  <div class="page home-split">
    <h1 class="visually-hidden">{site.github.name}</h1>

    <div class="home-copy">
      <section class="section">
        <p class="voice-bio">{voiceBio}</p>
      </section>

      <section class="section">
        <h2>Writing</h2>
        {
          posts.length ? (
            <ul class="quiet-list">
              {posts.slice(0, 5).map((post) => (
                <li>
                  <a href={`/blog/${post.data.slug}`}>{post.data.title}</a>
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toISOString().slice(0, 10)}
                  </time>
                  {post.data.summary ? (
                    <span class="meta">— {post.data.summary}</span>
                  ) : null}
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">No posts yet.</p>
          )
        }
      </section>

      <section class="section">
        <h2>Work</h2>
        <ul class="quiet-list">
          {
            projects.map((project) => (
              <li>
                <a href={project.url}>{project.title}</a>
                {project.blurb ? (
                  <span class="blurb"> — {project.blurb}</span>
                ) : null}
              </li>
            ))
          }
        </ul>
      </section>

      {
        capabilities.length ? (
          <section class="section">
            <h2>Capabilities</h2>
            <ul class="quiet-list">
              {capabilities.map((item) => (
                <li>
                  <span class="capability-heading">{item.heading}</span>
                  <span class="blurb"> — {item.body}</span>
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }

      <section class="section">
        <h2>Contact</h2>
        <ul class="quiet-list contact">
          {
            socials.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    {
      moods.length ? (
        <aside class="home-mood" aria-label="Mood illustration">
          {/* In-flow sizer reserves the right column; pin stays below chrome while copy scrolls */}
          <div class="home-mood-sizer" id="homeMoodSizer" aria-hidden="true" />
          <div class="home-mood-pin" id="homeMoodPin">
            <HeroMoodShell client:only="react" moods={moods} />
          </div>
        </aside>
      ) : null
    }
  </div>

  {
    moods.length ? (
      <script is:inline>
        ;(function () {
          var mq = window.matchMedia('(min-width: 1024px)')
          var sizer = document.getElementById('homeMoodSizer')
          var pin = document.getElementById('homeMoodPin')
          if (!sizer || !pin) return

          function sync() {
            if (!mq.matches) {
              pin.style.left = ''
              pin.style.width = ''
              pin.style.top = ''
              return
            }
            var chrome = document.querySelector('.chrome')
            var offset = chrome ? chrome.getBoundingClientRect().height : 68
            document.documentElement.style.setProperty(
              '--chrome-sticky-offset',
              offset + 'px',
            )
            var r = sizer.getBoundingClientRect()
            pin.style.left = r.left + 'px'
            pin.style.width = r.width + 'px'
            pin.style.top = 'var(--chrome-sticky-offset)'
          }

          sync()
          window.addEventListener('resize', sync)
          window.addEventListener('scroll', sync, { passive: true })
          if (mq.addEventListener) mq.addEventListener('change', sync)
          else mq.addListener(sync)
        })()
      </script>
    ) : null
  }
</BaseLayout>
