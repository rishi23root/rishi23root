---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroMoodShell from '../components/HeroMoodShell'
import { githubAvatarUrl, publishedPostsFilter, site } from '../lib/site'

const posts = (await getCollection('posts', publishedPostsFilter)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

const projects = (site.projects ?? [])
  .slice()
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
  .slice(0, 6)

const capabilities = site.capabilities ?? []
const moods = site.moods ?? []
const voiceBio = site.voiceBio ?? site.fullDescription

const socials = [
  { id: 'email', label: 'Email', href: `mailto:${site.contact.email}` },
  { id: 'website', label: 'Website', href: site.contact.socials.website },
  { id: 'x', label: 'X', href: site.contact.socials.x },
  { id: 'linkedin', label: 'LinkedIn', href: site.contact.socials.linkedin },
  { id: 'github', label: 'GitHub', href: site.contact.socials.github },
  { id: 'pypi', label: 'PyPI', href: site.contact.socials.pypi },
]

/** Avatar URL for schema/meta only — never rendered as on-page <img>. */
const avatarUrl = githubAvatarUrl(320)

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.github.name,
  url: site.siteUrl,
  email: site.contact.email,
  description: site.fullDescription,
  image: avatarUrl,
  sameAs: [
    site.contact.socials.website,
    site.contact.socials.x,
    site.contact.socials.linkedin,
    site.contact.socials.github,
    site.contact.socials.pypi,
  ],
}
---

<BaseLayout path="/" jsonLd={personJsonLd}>
  <div class="page home-split">
    <div class="home-copy">
      <h1 class="visually-hidden">{site.github.name}</h1>

      <section class="section">
        <p class="voice-bio">{voiceBio}</p>
      </section>

      <section class="section">
        <h2>Writing</h2>
        {
          posts.length ? (
            <ul class="quiet-list">
              {posts.slice(0, 5).map((post) => (
                <li>
                  <a href={`/blog/${post.data.slug}`}>{post.data.title}</a>
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toISOString().slice(0, 10)}
                  </time>
                  {post.data.summary ? (
                    <span class="meta">— {post.data.summary}</span>
                  ) : null}
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">No posts yet.</p>
          )
        }
      </section>

      <section class="section">
        <h2>Work</h2>
        <ul class="quiet-list">
          {
            projects.map((project) => (
              <li>
                <a href={project.url}>{project.title}</a>
                {project.blurb ? (
                  <span class="blurb"> — {project.blurb}</span>
                ) : null}
              </li>
            ))
          }
        </ul>
      </section>

      {
        capabilities.length ? (
          <section class="section">
            <h2>Capabilities</h2>
            <ul class="quiet-list">
              {capabilities.map((item) => (
                <li>
                  <span class="capability-heading">{item.heading}</span>
                  <span class="blurb"> — {item.body}</span>
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }

      <nav class="contact-icons" aria-label="Contact">
        {
          socials.map((item) => (
            <a
              class="contact-icon"
              href={item.href}
              aria-label={item.label}
              title={item.label}
              data-icon={item.id}
              {...(item.href.startsWith('http')
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              {item.id === 'email' ? (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5L4 8V6l8 5 8-5v2z"
                  />
                </svg>
              ) : null}
              {item.id === 'website' ? (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                  />
                </svg>
              ) : null}
              {item.id === 'x' ? (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.727-8.849L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"
                  />
                </svg>
              ) : null}
              {item.id === 'linkedin' ? (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM8.5 18H6v-8h2.5v8zM7.25 9.25A1.75 1.75 0 1 1 7.25 5.75a1.75 1.75 0 0 1 0 3.5zM18 18h-2.5v-4.2c0-1.55-.55-2.05-1.4-2.05-.9 0-1.35.65-1.55 1.25-.05.2-.05.45-.05.7V18H10v-8h2.4v1.1c.45-.75 1.2-1.35 2.55-1.35 1.85 0 3.05 1.2 3.05 3.8V18z"
                  />
                </svg>
              ) : null}
              {item.id === 'github' ? (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.43 7.86 10.96.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.64 1.58.24 2.75.12 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.07.78 2.16 0 1.56-.01 2.81-.01 3.19 0 .31.21.68.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.74 18.27.5 12 .5z"
                  />
                </svg>
              ) : null}
              {item.id === 'pypi' ? (
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M12 2C7.58 2 4 2.9 4 4.5v3c0 1.6 3.58 2.5 8 2.5s8-.9 8-2.5v-3C20 2.9 16.42 2 12 2zm0 1.5c3.87 0 6.5.7 6.5 1.5S15.87 6.5 12 6.5 5.5 5.8 5.5 5 8.13 3.5 12 3.5zM4 9v3c0 1.6 3.58 2.5 8 2.5s8-.9 8-2.5V9c-1.3.9-4.2 1.5-8 1.5S5.3 9.9 4 9zm0 5v3c0 1.6 3.58 2.5 8 2.5s8-.9 8-2.5v-3c-1.3.9-4.2 1.5-8 1.5S5.3 14.9 4 14zm0 5v.5C4 21.1 7.58 22 12 22s8-.9 8-2.5V19c-1.3.9-4.2 1.5-8 1.5S5.3 19.9 4 19z"
                  />
                </svg>
              ) : null}
            </a>
          ))
        }
      </nav>
    </div>

    {
      moods.length ? (
        <aside class="home-mood" id="homeMood" aria-label="Mood illustration">
          <div class="home-mood-inner" id="homeMoodInner">
            <HeroMoodShell client:only="react" moods={moods} />
          </div>
        </aside>
      ) : null
    }
  </div>

  {
    moods.length ? (
      <script is:inline>
        ;(function () {
          var mq = window.matchMedia('(min-width: 1024px)')
          var mood = document.getElementById('homeMood')
          var inner = document.getElementById('homeMoodInner')
          if (!mood || !inner) return

          function sync() {
            if (!mq.matches) {
              inner.style.left = ''
              inner.style.width = ''
              return
            }
            /* Use the grid column box even when aside height is 0 */
            var r = mood.getBoundingClientRect()
            if (!r.width) return
            inner.style.left = r.left + 'px'
            inner.style.width = r.width + 'px'
          }

          sync()
          window.addEventListener('resize', sync)
          window.addEventListener('scroll', sync, { passive: true })
          if (mq.addEventListener) mq.addEventListener('change', sync)
          else mq.addListener(sync)
        })()
      </script>
    ) : null
  }
</BaseLayout>
