---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactIcons from '../components/ContactIcons.astro'
import SiteChrome from '../components/SiteChrome.astro'
import HeroMoodShell from '../components/HeroMoodShell'
import { githubAvatarUrl, site, socialLinks } from '../lib/site'
import { getPublishedPosts, isoDay, postPath } from '../lib/posts'

const posts = (await getPublishedPosts()).slice(0, 5)

const projects = (site.projects ?? [])
  .slice()
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
  .slice(0, 3)

const capabilities = site.capabilities ?? []
const moods = site.moods ?? []
const voiceBio = site.voiceBio ?? site.fullDescription

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.github.name,
  url: site.siteUrl,
  email: site.contact.email,
  description: site.fullDescription,
  // Avatar for schema only — never rendered as an on-page <img>.
  image: githubAvatarUrl(320),
  sameAs: socialLinks.filter((link) => link.id !== 'email').map((link) => link.href),
}
---

<BaseLayout path="/" jsonLd={personJsonLd}>
  <div class="page home-split">
    {/* Text column (≈60% on wide screens). Mood plate sits to its left. */}
    <div class="home-text">
      <SiteChrome path="/" />
      <div class="home-copy">
        <h1 class="visually-hidden">{site.github.name}</h1>

        <section class="home-section home-section-bio reveal" style="--i: 0">
          <p class="voice-bio">{voiceBio}</p>
        </section>

        <section class="home-section reveal" style="--i: 1">
          <h2>Writing</h2>
          {
            posts.length ? (
              <ul class="home-list home-writing-list">
                {posts.map((post) => (
                  <li class="hover-row">
                    <a class="row-link" href={postPath(post.data.slug)}>{post.data.title}</a>
                    <time datetime={post.data.date.toISOString()}>{isoDay(post.data.date)}</time>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="empty">No posts yet.</p>
            )
          }
        </section>

        <section class="home-section reveal" style="--i: 2">
          <h2>Work</h2>
          <ul class="home-list home-stack-list">
            {
              projects.map((project) => (
                <li class="hover-row">
                  <a class="row-link" href={project.url}>{project.title}</a>
                  {project.blurb ? <span class="blurb">{project.blurb}</span> : null}
                </li>
              ))
            }
          </ul>
        </section>

        {
          capabilities.length ? (
            <section class="home-section reveal" style="--i: 3">
              <h2>Capabilities</h2>
              <ul class="home-list home-stack-list">
                {capabilities.map((item) => (
                  <li class="hover-row">
                    <span class="capability-heading">{item.heading}</span>
                    <span class="blurb">{item.body}</span>
                  </li>
                ))}
              </ul>
            </section>
          ) : null
        }

        <div class="reveal" style="--i: 4">
          <ContactIcons />
        </div>
      </div>
    </div>

    {
      moods.length ? (
        <aside class="home-mood reveal" style="--i: 0" aria-label="Mood illustration">
          <div class="home-mood-sticky">
            <HeroMoodShell client:only="react" moods={moods} />
          </div>
        </aside>
      ) : null
    }
  </div>
</BaseLayout>
