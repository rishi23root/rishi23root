---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactIcons from '../components/ContactIcons.astro'
import SiteChrome from '../components/SiteChrome.astro'
import HeroMoodShell from '../components/HeroMoodShell'
import { githubAvatarUrl, site, socialLinks } from '../lib/site'
import { getPublishedPosts, isoDay, postPath } from '../lib/posts'

const posts = (await getPublishedPosts()).slice(0, 5)

const projects = (site.projects ?? [])
  .slice()
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
  .slice(0, 3)

const capabilities = site.capabilities ?? []
const moods = site.moods ?? []
const voiceBio = site.voiceBio ?? site.fullDescription
// Only what the inline head script needs to pick and preload the first mood.
const heroMoods = moods.map((m) => ({ id: m.id, src: m.src }))

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.github.name,
  url: site.siteUrl,
  email: site.contact.email,
  description: site.fullDescription,
  // Avatar for schema only — never rendered as an on-page <img>.
  image: githubAvatarUrl(320),
  sameAs: socialLinks.filter((link) => link.id !== 'email').map((link) => link.href),
}
---

<BaseLayout path="/" jsonLd={personJsonLd}>
  {
    /* Start the first mood download from <head>, before React hydrates
       HeroMoodShell. Desktop only (the plate is display:none below 1024px).
       Picks the mood exactly as HeroMoodShell would: ?mood=<id> wins, else
       advance the shuffle bag — keep in sync with moods/cycle.ts. The pick is
       handed over on window.__heroMoodFirst so React does not advance again. */
    moods.length ? (
      <script slot="head" define:vars={{ heroMoods, cycleKey: 'mood-cycle:v1' }}>
        try {
          if (window.matchMedia('(min-width: 1024px)').matches) {
            var ids = heroMoods.map(function (m) { return m.id })
            var forced = new URLSearchParams(window.location.search).get('mood')
            var id = forced && ids.indexOf(forced) !== -1 ? forced : null
            if (!id) {
              var shuffle = function (avoid) {
                var o = ids.slice()
                for (var i = o.length - 1; i > 0; i--) {
                  var j = Math.floor(Math.random() * (i + 1))
                  var t = o[i]; o[i] = o[j]; o[j] = t
                }
                if (avoid && o.length > 1 && o[0] === avoid) {
                  var k = 1 + Math.floor(Math.random() * (o.length - 1))
                  var u = o[0]; o[0] = o[k]; o[k] = u
                }
                return o
              }
              var prev = null
              try {
                prev = JSON.parse(localStorage.getItem(cycleKey) || 'null')
                if (
                  !prev || !Array.isArray(prev.order) || typeof prev.index !== 'number' ||
                  prev.order.length !== ids.length ||
                  !ids.every(function (x) { return prev.order.indexOf(x) !== -1 })
                ) prev = null
              } catch (e) { prev = null }
              var next
              if (!prev) next = { order: shuffle(), index: 0 }
              else if (prev.index + 1 >= prev.order.length) next = { order: shuffle(prev.order[prev.index]), index: 0 }
              else next = { order: prev.order, index: prev.index + 1 }
              try { localStorage.setItem(cycleKey, JSON.stringify(next)) } catch (e) {}
              id = next.order[next.index]
            }
            window.__heroMoodFirst = id
            var hit = heroMoods.filter(function (m) { return m.id === id })[0]
            if (hit && hit.src) {
              var link = document.createElement('link')
              link.rel = 'preload'
              link.as = 'image'
              link.href = hit.src
              if (/\.webp$/.test(hit.src)) link.type = 'image/webp'
              link.setAttribute('fetchpriority', 'high')
              link.setAttribute('data-hero-mood', id)
              document.head.appendChild(link)
            }
          }
        } catch (e) {}
      </script>
    ) : null
  }
  <div class="page home-split">
    {/* Text column (≈60% on wide screens). Mood plate sits to its left. */}
    <div class="home-text">
      <SiteChrome path="/" />
      <div class="home-copy">
        <h1 class="visually-hidden">{site.github.name}</h1>

        <section class="home-section home-section-bio reveal" style="--i: 0">
          <p class="voice-bio">{voiceBio}</p>
        </section>

        <section class="home-section reveal" style="--i: 1">
          <h2>Writing</h2>
          {
            posts.length ? (
              <ul class="home-list home-writing-list">
                {posts.map((post) => (
                  <li class="hover-row">
                    <a class="row-link" href={postPath(post.data.slug)}>{post.data.title}</a>
                    <time datetime={post.data.date.toISOString()}>{isoDay(post.data.date)}</time>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="empty">No posts yet.</p>
            )
          }
        </section>

        <section class="home-section reveal" style="--i: 2">
          <h2>Work</h2>
          <ul class="home-list home-stack-list">
            {
              projects.map((project) => (
                <li class="hover-row">
                  <a class="row-link" href={project.url}>{project.title}</a>
                  {project.blurb ? <span class="blurb">{project.blurb}</span> : null}
                </li>
              ))
            }
          </ul>
        </section>

        {
          capabilities.length ? (
            <section class="home-section reveal" style="--i: 3">
              <h2>Capabilities</h2>
              <ul class="home-list home-stack-list">
                {capabilities.map((item) => (
                  <li class="hover-row" tabindex="0">
                    <span class="capability-heading">{item.heading}</span>
                    <span class="blurb">{item.body}</span>
                  </li>
                ))}
              </ul>
            </section>
          ) : null
        }

        <div class="reveal" style="--i: 4">
          <ContactIcons />
        </div>
      </div>
    </div>

    {
      moods.length ? (
        <aside class="home-mood reveal" style="--i: 0" aria-label="Mood illustration">
          <div class="home-mood-sticky">
            <HeroMoodShell client:only="react" moods={moods} />
          </div>
        </aside>
      ) : null
    }
  </div>
</BaseLayout>
