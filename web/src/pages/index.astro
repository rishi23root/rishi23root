---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { publishedPostsFilter, site } from '../lib/site'

const posts = (await getCollection('posts', publishedPostsFilter)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

const featured = site.opensource.active.slice(0, 6)
const socials = [
  { label: 'Email', href: `mailto:${site.contact.email}` },
  { label: 'Website', href: site.contact.socials.website },
  { label: 'X', href: site.contact.socials.x },
  { label: 'LinkedIn', href: site.contact.socials.linkedin },
  { label: 'GitHub', href: site.contact.socials.github },
  { label: 'PyPI', href: site.contact.socials.pypi },
]

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.github.name,
  url: site.siteUrl,
  email: site.contact.email,
  description: site.fullDescription,
  sameAs: [
    site.contact.socials.website,
    site.contact.socials.x,
    site.contact.socials.linkedin,
    site.contact.socials.github,
    site.contact.socials.pypi,
  ],
}
---

<BaseLayout path="/" jsonLd={personJsonLd}>
  <section class="hero">
    <p class="prompt">$ whoami</p>
    <h1>
      {site.github.name} — {site.shortBio}
    </h1>
    <p class="lede">{site.fullDescription}</p>
  </section>

  <section class="section">
    <h2>Mottos</h2>
    <p class="mottos">
      {site.mottos.map((line) => `「${line}」`).join(' · ')}
    </p>
  </section>

  <section class="section">
    <h2>Stack</h2>
    <p class="stack-line">{site.stackLine}</p>
  </section>

  <section class="section">
    <h2>Featured work</h2>
    <ul class="list">
      {
        featured.map((fullName) => {
          const blurb = site.opensource.blurbs[fullName] ?? ''
          return (
            <li>
              <a href={`https://github.com/${fullName}`}>{fullName}</a>
              {blurb ? <span class="meta">{blurb}</span> : null}
            </li>
          )
        })
      }
    </ul>
  </section>

  <section class="section">
    <h2>Writing</h2>
    {
      posts.length ? (
        <ul class="list">
          {posts.slice(0, 5).map((post) => (
            <li>
              <a href={`/blog/${post.data.slug}`}>{post.data.title}</a>
              <span class="meta">
                {post.data.date.toISOString().slice(0, 10)}
                {post.data.summary ? ` — ${post.data.summary}` : ''}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No posts yet.</p>
      )
    }
  </section>

  <section class="section">
    <h2>Contact</h2>
    <ul class="contact">
      {
        socials.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
