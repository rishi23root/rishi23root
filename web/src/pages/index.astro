---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactIcons from '../components/ContactIcons.astro'
import HeroMoodShell from '../components/HeroMoodShell'
import { githubAvatarUrl, publishedPostsFilter, site } from '../lib/site'

const posts = (await getCollection('posts', publishedPostsFilter)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

const projects = (site.projects ?? [])
  .slice()
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99))
  .slice(0, 6)

const capabilities = site.capabilities ?? []
const moods = site.moods ?? []
const voiceBio = site.voiceBio ?? site.fullDescription

/** Avatar URL for schema/meta only — never rendered as on-page <img>. */
const avatarUrl = githubAvatarUrl(320)

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.github.name,
  url: site.siteUrl,
  email: site.contact.email,
  description: site.fullDescription,
  image: avatarUrl,
  sameAs: [
    site.contact.socials.website,
    site.contact.socials.x,
    site.contact.socials.linkedin,
    site.contact.socials.github,
    site.contact.socials.pypi,
  ],
}
---

<BaseLayout path="/" jsonLd={personJsonLd}>
  <div class="page home-split">
    <div class="home-copy">
      <h1 class="visually-hidden">{site.github.name}</h1>

      <section class="section">
        <p class="voice-bio">{voiceBio}</p>
      </section>

      <section class="section">
        <h2>Writing</h2>
        {
          posts.length ? (
            <ul class="quiet-list">
              {posts.slice(0, 5).map((post) => (
                <li>
                  <a href={`/writing/${post.data.slug}`}>{post.data.title}</a>
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toISOString().slice(0, 10)}
                  </time>
                  {post.data.summary ? (
                    <span class="meta">— {post.data.summary}</span>
                  ) : null}
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">No posts yet.</p>
          )
        }
      </section>

      <section class="section">
        <h2>Work</h2>
        <ul class="quiet-list">
          {
            projects.map((project) => (
              <li>
                <a href={project.url}>{project.title}</a>
                {project.blurb ? (
                  <span class="blurb"> — {project.blurb}</span>
                ) : null}
              </li>
            ))
          }
        </ul>
      </section>

      {
        capabilities.length ? (
          <section class="section">
            <h2>Capabilities</h2>
            <ul class="quiet-list">
              {capabilities.map((item) => (
                <li>
                  <span class="capability-heading">{item.heading}</span>
                  <span class="blurb"> — {item.body}</span>
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }

      <ContactIcons />
    </div>

    {
      moods.length ? (
        <aside class="home-mood" id="homeMood" aria-label="Mood illustration">
          <div class="home-mood-inner" id="homeMoodInner">
            <HeroMoodShell client:only="react" moods={moods} />
          </div>
        </aside>
      ) : null
    }
  </div>

  {
    moods.length ? (
      <script is:inline>
        ;(function () {
          var mq = window.matchMedia('(min-width: 1024px)')
          var mood = document.getElementById('homeMood')
          var inner = document.getElementById('homeMoodInner')
          if (!mood || !inner) return

          function sync() {
            if (!mq.matches) {
              inner.style.left = ''
              inner.style.width = ''
              inner.style.top = ''
              inner.style.height = ''
              return
            }
            /* Column box (aside height is 0) + space below sticky chrome */
            var r = mood.getBoundingClientRect()
            if (!r.width) return
            var chrome = document.querySelector('.shell-home > .chrome')
            var chromeBottom = chrome
              ? chrome.getBoundingClientRect().bottom
              : 0
            var top = Math.max(0, chromeBottom)
            inner.style.left = r.left + 'px'
            inner.style.width = r.width + 'px'
            inner.style.top = top + 'px'
            inner.style.height = Math.max(0, window.innerHeight - top) + 'px'
          }

          sync()
          window.addEventListener('resize', sync)
          window.addEventListener('scroll', sync, { passive: true })
          if (mq.addEventListener) mq.addEventListener('change', sync)
          else mq.addListener(sync)
        })()
      </script>
    ) : null
  }
</BaseLayout>
