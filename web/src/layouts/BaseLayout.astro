---
import '../styles/global.css'
import SiteChrome from '../components/SiteChrome.astro'
import { absoluteUrl, site } from '../lib/site'

type Props = {
  title?: string
  description?: string
  path?: string
  type?: 'website' | 'article'
  publishedTime?: Date | string
  image?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  title,
  description = site.fullDescription,
  path = '/',
  type = 'website',
  publishedTime,
  image = '/og-default.png',
  jsonLd,
} = Astro.props

const pageTitle = title ? `${title} · ${site.github.name}` : site.github.name
const canonical = absoluteUrl(path)
const ogImage = absoluteUrl(image)
const published = publishedTime ? new Date(publishedTime).toISOString() : undefined
const jsonLdBlocks = jsonLd ? [jsonLd].flat() : []

const isHome = path === '/'
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.github.name} RSS`}
      href={absoluteUrl('/rss.xml')}
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.github.name} />
    {
      published ? (
        <meta property="article:published_time" content={published} />
      ) : null
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }

    <link
      rel="preload"
      href="/fonts/source-sans-3-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      ;(function () {
        try {
          var stored = localStorage.getItem('theme')
          var theme =
            stored === 'light' || stored === 'dark' ? stored : 'dark'
          document.documentElement.setAttribute('data-theme', theme)
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark')
        }
      })()
    </script>
  </head>
  <body>
    {
      /* Inner pages: nav bar above the content. Home puts its nav in the
         text column instead (index.astro). */
      !isHome ? (
        <div class="chrome-bar">
          <SiteChrome path={path} />
        </div>
      ) : null
    }
    <div class:list={['shell', isHome ? 'shell-home' : 'shell-inner']}>
      <main>
        <slot />
      </main>
    </div>
    <script is:inline>
      ;(function () {
        var toggle = document.getElementById('themeToggle')
        var theme =
          document.documentElement.getAttribute('data-theme') || 'dark'

        function applyTheme(next) {
          theme = next
          document.documentElement.setAttribute('data-theme', theme)
          if (toggle) {
            var label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
            toggle.setAttribute('aria-label', label)
            toggle.setAttribute('title', label)
          }
          try {
            localStorage.setItem('theme', theme)
          } catch (e) {}
        }

        applyTheme(theme === 'light' ? 'light' : 'dark')
        if (toggle) {
          toggle.addEventListener('click', function () {
            applyTheme(theme === 'dark' ? 'light' : 'dark')
          })
        }
      })()
    </script>
  </body>
</html>
