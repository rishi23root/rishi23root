---
import '../styles/global.css'
import SiteChrome from '../components/SiteChrome.astro'
import { absoluteUrl, site } from '../lib/site'
import { DESKTOP_MQ } from '../components/moods/media'

type Props = {
  title?: string
  description?: string
  path?: string
  type?: 'website' | 'article'
  publishedTime?: Date | string
  image?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  title,
  description = site.fullDescription,
  path = '/',
  type = 'website',
  publishedTime,
  image = '/og-default.png',
  jsonLd,
} = Astro.props

const pageTitle = title ? `${title} · ${site.github.name}` : site.github.name
const canonical = absoluteUrl(path)
const ogImage = absoluteUrl(image)
const published = publishedTime ? new Date(publishedTime).toISOString() : undefined
const jsonLdBlocks = jsonLd ? [jsonLd].flat() : []

const isHome = path === '/'
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.github.name} RSS`}
      href={absoluteUrl('/rss.xml')}
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.github.name} />
    {
      published ? (
        <meta property="article:published_time" content={published} />
      ) : null
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }

    <link
      rel="preload"
      href="/fonts/source-sans-3-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // <html> ships as dark; only a saved light choice needs applying.
      try {
        if (localStorage.getItem('theme') === 'light')
          document.documentElement.setAttribute('data-theme', 'light')
      } catch (e) {}
    </script>
    <slot name="head" />
    {
      isHome ? (
        <script is:inline define:vars={{ desktopMq: DESKTOP_MQ }}>
          ;(function () {
            try {
              if (
                window.matchMedia(desktopMq).matches &&
                !window.matchMedia('(prefers-reduced-motion: reduce)').matches
              ) {
                document.documentElement.classList.add('mood-await')
              }
            } catch (e) {}
            window.addEventListener('pagereveal', function (e) {
              if (e.viewTransition) {
                window.__homePageVt = e.viewTransition.finished
              }
            })
          })()
        </script>
      ) : null
    }
  </head>
  <body>
    {
      /* Inner pages: nav bar above the content. Home puts its nav in the
         text column instead (index.astro). */
      !isHome ? (
        <div class="chrome-bar">
          <SiteChrome path={path} />
        </div>
      ) : null
    }
    <div class:list={['shell', isHome ? 'shell-home' : 'shell-inner']}>
      <main>
        <slot />
      </main>
    </div>
    <script is:inline>
      ;(function () {
        var toggle = document.getElementById('themeToggle')
        if (!toggle) return
        var root = document.documentElement
        function syncLabel() {
          var label =
            root.getAttribute('data-theme') === 'light' ? 'Switch to dark mode' : 'Switch to light mode'
          toggle.setAttribute('aria-label', label)
          toggle.setAttribute('title', label)
        }
        syncLabel()
        toggle.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light'
          root.setAttribute('data-theme', next)
          try {
            localStorage.setItem('theme', next)
          } catch (e) {}
          syncLabel()
        })
      })()
    </script>
  </body>
</html>
